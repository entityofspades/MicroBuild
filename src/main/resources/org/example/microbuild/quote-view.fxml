<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="600.0" style="-fx-background-color: #100344;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.microbuild.QuoteController">
    <children>
        <VBox alignment="CENTER" prefHeight="50.0" style="-fx-background-color: #180118;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <Label text="PC Build Quotation &amp; Summary" textFill="WHITE">
                    <font><Font name="Inter Regular" size="18.0" /></font>
                </Label>
            </children>
        </VBox>

        <TextArea fx:id="quoteTextArea" editable="false" style="-fx-font-family: 'Monospaced';" wrapText="true" AnchorPane.bottomAnchor="60.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="65.0" />

        <Button layoutX="240.0" layoutY="450.0" mnemonicParsing="false" onAction="#handleBackToHome" prefHeight="35.0" prefWidth="140.0" style="-fx-background-color: #ef4444; -fx-text-fill: white;" text="← Back to Home" AnchorPane.bottomAnchor="15.0" AnchorPane.rightAnchor="20.0">
            <font><Font name="Inter Regular" size="12.0" /></font>
        </Button>
    </children>
</AnchorPane>